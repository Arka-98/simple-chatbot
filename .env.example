# Copy this file to `.env` and fill in your own values.

# Required. Get a key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional. `deepseek-flash` (DeepSeek-V4.1-Flash, fast) or `deepseek-v4-pro` (stronger).
DEEPSEEK_MODEL=deepseek-flash

# Optional. Where the SQLite database file is created.
CHATBOT_DB_PATH=data/chatbot.db
